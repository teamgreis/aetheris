<Window
    x:Class="Aetheris.Studio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Aetheris.Studio.Views"
    mc:Ignorable="d"
    Title="Aetheris Studio"
    ExtendsContentIntoTitleBar="True"
    SystemBackdrop="{ThemeResource MicaBackdrop}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="Assets/Icon.png" Width="32" Height="32" Margin="12,0,8,0" />
            <TextBlock Grid.Column="1" Text="Aetheris Studio" Style="{StaticResource TitleText}" VerticalAlignment="Center" Margin="0,0,0,4" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE712;" ToolTipService.ToolTip="Settings" Click="SettingsButton_Click" />
                <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE898;" ToolTipService.ToolTip="Minimize" Click="MinimizeButton_Click" />
                <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE923;" ToolTipService.ToolTip="Maximize" Click="MaximizeButton_Click" />
                <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE711;" ToolTipService.ToolTip="Close" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />

    </Grid>
</Window>