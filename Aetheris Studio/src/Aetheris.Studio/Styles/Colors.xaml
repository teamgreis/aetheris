<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=System.Runtime">

    <!-- Color Palette -->
    <Color x:Key="PrimaryColor">#6366F1</Color>      <!-- Indigo 500 -->
    <Color x:Key="PrimaryHoverColor">#4F46E5</Color>  <!-- Indigo 600 -->
    <Color x:Key="PrimaryPressedColor">#4338CA</Color> <!-- Indigo 700 -->
    <Color x:Key="SecondaryColor">#14B8A6</Color>     <!-- Teal 500 -->
    <Color x:Key="SurfaceColor">#1E1E2E</Color>       <!-- Dark surface -->
    <Color x:Key="SurfaceVariantColor">#282838</Color> <!-- Elevated surface -->
    <Color x:Key="BackgroundColor">#161620</Color>    <!-- App background -->
    <Color x:Key="OutlineColor">#3A3A4A</Color>       <!-- Borders -->
    <Color x:Key="OnSurfaceColor">#E8E8F0</Color>     <!-- Primary text -->
    <Color x:Key="OnSurfaceVariantColor">#A0A0B0</Color> <!-- Secondary text -->
    <Color x:Key="ErrorColor">#F43F5E</Color>         <!-- Rose 500 -->
    <Color x:Key="SuccessColor">#22C55E</Color>       <!-- Green 500 -->
    <Color x:Key="WarningColor">#FBBF24</Color>       <!-- Amber 400 -->

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariantColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

    <!-- Typography -->
    <FontFamily x:Key="UIFontFamily">Segoe UI Variable, Segoe UI, system-ui</FontFamily>
    <System:Double x:Key="FontSizeSmall">12</System:Double>
    <System:Double x:Key="FontSizeBody">14</System:Double>
    <System:Double x:Key="FontSizeLarge">16</System:Double>
    <System:Double x:Key="FontSizeTitle">20</System:Double>
    <System:Double x:Key="FontSizeHeading">28</System:Double>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>

    <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="HeadingText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

</ResourceDictionary>